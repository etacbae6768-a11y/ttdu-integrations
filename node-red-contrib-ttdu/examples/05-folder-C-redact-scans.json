      [
        "p00000026"
      ]
    ]
  },
  {
    "id": "p00000026",
    "z": "tab00000021",
    "type": "split",
    "name": "one msg per result",
    "splt": "\\n",
    "spltType": "str",
    "arraySplt": 1,
    "arraySpltType": "len",
    "stream": false,
    "addname": "",
    "x": 900,
    "y": 80,
    "wires": [
      [
        "m00000027"
      ]
    ]
  },
  {
    "id": "m00000027",
    "z": "tab00000021",
    "type": "function",
    "name": "name in C:/TTDU/out-redact",
    "func": "// one result from one input: keep the input's base name (h-001.hwpx -> h-001.pdf)\nconst base = String(msg.inputFilename || '').split(/[\\\\/]/).pop().replace(/\\.[^.]+$/, '');\nconst ext = (msg.payload.name.match(/\\.[^.]+$/) || [''])[0];\nconst name = msg.ttdu.count === 1 && base ? base + ext : msg.payload.name;\nmsg.filename = \"C:/TTDU/out-redact\" + '/' + name;\nmsg.payload = msg.payload.data;\nreturn msg;",
    "outputs": 1,
    "x": 1080,
    "y": 80,
    "wires": [
      [
        "o00000028"
      ]
    ]
  },
  {
    "id": "o00000028",
    "z": "tab00000021",
    "type": "file",
    "name": "write result",
    "filename": "filename",
    "filenameType": "msg",
    "appendNewline": false,
    "createDir": true,
    "overwriteFile": "true",
    "encoding": "none",
    "x": 1260,
    "y": 80,
    "wires": [
