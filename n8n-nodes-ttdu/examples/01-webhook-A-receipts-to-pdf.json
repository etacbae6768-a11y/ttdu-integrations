        0
      ],
      "parameters": {
        "jsCode": "const out = [];\nfor (const [i, it] of $input.all().entries()) {\n  const files = [];\n  for (const f of it.json.files || []) {\n    const b = await this.helpers.getBinaryDataBuffer(i, f.binaryProperty);\n    files.push({ name: f.name, mime: f.mime, size: f.size, sha256: f.sha256, base64: b.toString('base64') });\n  }\n  out.push({ json: { ok: it.json.ok, count: it.json.count, notes: it.json.notes, files } });\n}\nreturn out;"
      }
    },
