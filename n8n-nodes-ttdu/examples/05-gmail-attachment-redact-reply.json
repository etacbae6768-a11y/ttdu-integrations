{
  "name": "TTDU Gmail attachment → redact → reply",
  "active": false,
  "id": "ttduWfGmail00001",
  "nodes": [
    {
      "id": "g1",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "q": "has:attachment subject:redact"
        },
        "options": {
          "downloadAttachments": true
        }
      }
    },
    {
      "id": "g2",
      "name": "TTDU",
      "type": "n8n-nodes-ttdu.ttdu",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "credentials": {
        "ttduApi": {
          "id": "ttduLocal00001",
          "name": "TTDU this PC"
        }
      },
      "parameters": {
        "flow": "C",
        "binaryProperties": "",
        "client": "",
        "date": "",
        "options": {
          "prefix": "attachment_"
        }
      }
    },
    {
      "id": "g3",
      "name": "Gmail Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "reply",
        "messageId": "={{ $('Gmail Trigger').item.json.id }}",
        "emailType": "text",
        "message": "Attached is a copy with personal data redacted (processed on this office PC only).",
        "options": {
          "attachmentsUi": {
            "attachmentsBinary": [
              {
                "property": "attachment_0"
              }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "TTDU",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "TTDU": {
      "main": [
        [
          {
            "node": "Gmail Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}